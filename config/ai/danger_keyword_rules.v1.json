{
  "schema_version": "ai.danger_keyword_rules.v1",
  "source_column": "中文字段",
  "target_column": "危险等级",
  "target_value": "1",
  "exclude_patterns": [
    "^Key_",
    "系数",
    "商品.{0,8}(?:描述|说明|文本)",
    "(?:描述|说明|文本).{0,8}商品"
  ],
  "groups": [
    {
      "id": "reward",
      "description": "奖励、奖品、掉落和产出",
      "patterns": [
        "奖励",
        "奖品",
        "掉落",
        "产出"
      ]
    },
    {
      "id": "lifecycle_time",
      "description": "玩法和活动生命周期时间",
      "patterns": [
        "(?:开启|开放|开始|起始|生效|上线|开服|售卖|结束|关闭|截止|下线|失效|过期|持续|冷却|间隔|刷新)时间",
        "时间(?:上限|下限)"
      ]
    },
    {
      "id": "price_payment",
      "description": "价格、商品、付费、充值和折扣",
      "patterns": [
        "价格",
        "售价",
        "原价",
        "现价",
        "定价",
        "单价",
        "金额",
        "付费",
        "充值",
        "内购",
        "商品",
        "SKU",
        "折扣",
        "返利",
        "费率"
      ]
    },
    {
      "id": "frequency_limit",
      "description": "使用、购买、领取和挑战次数限制",
      "patterns": [
        "次数",
        "限购",
        "购买上限",
        "兑换上限",
        "领取上限",
        "挑战上限",
        "可购买"
      ]
    },
    {
      "id": "cost",
      "description": "资源消耗和费用",
      "patterns": [
        "消耗",
        "消费",
        "扣除",
        "花费",
        "成本",
        "费用"
      ]
    },
    {
      "id": "switch",
      "description": "功能开关和启禁状态",
      "patterns": [
        "开关",
        "是否开启",
        "是否开放",
        "是否启用",
        "启用状态",
        "禁用",
        "关闭功能",
        "功能关闭",
        "屏蔽"
      ]
    },
    {
      "id": "item_quantity",
      "description": "道具、物品、奖励和货币数量",
      "patterns": [
        "(?:道具|物品|奖品|奖励|货币|金币|钻石|代币).{0,4}数量",
        "数量.{0,4}(?:道具|物品|奖品|奖励|货币|金币|钻石|代币)"
      ]
    },
    {
      "id": "probability",
      "description": "概率、几率、权重和掉率",
      "patterns": [
        "概率",
        "几率",
        "机率",
        "权重",
        "掉率",
        "爆率"
      ]
    },
    {
      "id": "unlock_condition",
      "description": "解锁、开启和前置条件",
      "patterns": [
        "解锁条件",
        "开启条件",
        "开放条件",
        "前置条件",
        "等级要求",
        "准入条件"
      ]
    },
    {
      "id": "balance_boundary",
      "description": "数值上下限、保底、倍率和阈值",
      "patterns": [
        "上限",
        "下限",
        "封顶",
        "保底",
        "倍率",
        "百分比",
        "阈值",
        "临界值"
      ]
    },
    {
      "id": "economy_mechanic",
      "description": "抽奖、卡池、奖池和兑换机制",
      "patterns": [
        "抽奖",
        "卡池",
        "奖池",
        "兑换"
      ]
    }
  ]
}